                      ; =====================================================================
                      ; I2C master LH v1.0 for the Sharp PC-1600 - runs on the LH-5803 (XCALL)
                      ;
                      ; This is the PC-1500 driver i2c_v1.4.asm of
                      ; https://github.com/Ante1000/Sharp_PC-1500_I2C_interface adapted to the PC-1600.
                      ; The LH-5803 of the PC-1600 is the CPU of the PC-1500 (LH5801 code, 1.3 MHz) and sees the same
                      ; port block at &F000 of the ME1 space. Pins of the 60-pin connector:
                      ;   SCL      = pin 29 (CMTOUT = SDO), port C &F008 bit 7 (PC7)       (through a diode)
                      ;   SDA read = pin 27 (CMTIN  = PB2), OPB &F00F bit 2                (through 470 ohm)
                      ;   SDA pull = pin 15 (PU), the PU flip-flop of the LH-5803: SPU = released, RPU = low
                      ;                                                                    (through a diode)
                      ; Changes against v1.4:
                      ;   - PB2 cannot drive the line on the PC-1600, so SDA is driven by PU: SDA = 0 is RPU, SDA = 1
                      ;     is SPU (1 byte, 4 cycles) instead of the open drain emulated with DDB/OPB (17 cycles).
                      ;     There is no OPB latch to clear and DDB bit 2 only has to be an input (once, at the start).
                      ;   - X = &F00F all the time (the read of SDA).
                      ;   - No SIE at the end: the interrupts of the LH-5803 are left as they are after RIE.
                      ;   - PU is left high (SDA released) when the routine returns; PU is also a memory bank signal of
                      ;     the PC-1600 slots: use it without memory cards in the slots until it is checked.
                      ; Memory (Z80 addresses = LH addresses + &8000; reserve with NEW "S0:",&1000):
                      ;   LH &4A00 (Z80 &CA00)  RX buffer      LH &4B00 (Z80 &CB00)  TX buffer
                      ;   LH &4C00 (Z80 &CC00)  code, IC = &4C00 (XCALL)   &4CFC IA  &4CFD IW  &4CFE IR  &4CFF IS
                      ; Call (BASIC):  POKE &CCFC, D, W, R : XCALL &4C00, E       (buffers: POKE/PEEK &CB00, &CA00)
                      ; Results as for the Z80 driver: 0 OK, 1 no ACK after the address, 2 no ACK after a data
                      ; byte, 3 SDA stuck low.
                      ; Symbols filled in by the assembler (-D): IP=&4C TP=&4B RP=&4A BM=4 DB=&FB.
                      ; The original comment block (explanation of the loops) follows in the PC-1500 source.
                      ; =====================================================================
00  FD BE                  RIE                     ; no interrupts
02  48 F0                  LDI  XH,&F0
04  4A 0F                  LDI  XL,&0F             ; X = &F00F (OPB: read SDA), unchanged below
06  58 F0                  LDI  YH,&F0
08  5A 08                  LDI  YL,&08             ; Y = &F008 (port C: SCL = PC7)
0A  FD E9 F0 0D FB         ANI  #(&F00D),DB        ; DDB: PB2 is an input (it only reads SDA)
0F  E1                     SPU                     ; SDA = 1 (released)
10  FD 5B 80               ORI  #(Y),&80           ; SCL = 1
13  6A 09                  LDI  UL,9               ; SDA = 0: up to 10 SCL pulses
15  FD 4D 04       BUSY:   BII  #(X),BM            ; SDA = 1 -> bus free
18  89 0C                  BZR+ FREE
1A  FD 59 7F               ANI  #(Y),&7F           ; SCL pulse: a device that holds
1D  FD 5B 80               ORI  #(Y),&80           ; SDA sends its next bit
20  88 0D                  LOP  UL,BUSY
22  B5 03                  LDI  A,3                ; SDA still 0: result 3, no START/STOP
24  8E 63                  BCH+ EXIT
26  6A 00          FREE:   LDI  UL,0               ; UL = 0 (= W when reading without a write)
28  A5 4C FD               LDA  (IP,&FD)           ; W
2B  AE 4C CC               STA  (IP,WCMP+1)        ; W into the instruction CPI UL,W in SEND
2E  89 05                  BZR+ WR
30  A5 4C FE               LDA  (IP,&FE)           ; R
33  89 12                  BZR+ RD                 ; W = 0, R > 0: read at once
35  68 4B          WR:     LDI  UH,TP              ; U = TX
37  F9                     REC                     ; C = 0: address for writing
38  BE 4C 9A               SJP  ADDR               ; address, then W bytes from TX
3B  83 05                  BCS+ WEND               ; C = 1: everything acknowledged
3D  24                     LDA  UL                 ; no ACK: UL = 0 -> after the address
3E  8B 3C                  BZS+ NAKA
40  8E 3E                  BCH+ NAKD
42  A5 4C FE       WEND:   LDA  (IP,&FE)           ; R
45  8B 31                  BZS+ OK
47  AE 4C 69       RD:     STA  (IP,RCMP+1)        ; A = R (from FREE or WEND) into CPI UL,R
4A  FB                     SEC                     ; C = 1: address for reading (UL = W, so SEND
4B  BE 4C 9A               SJP  ADDR               ; ends after the address alone)
4E  81 2C                  BCR+ NAKA
50  0C                     DCS  (X)                ; time for the device: SCL low for about 77 us
51  F9                     REC                     ; C = 0: the receive loop needs this
52  68 4A                  LDI  UH,RP
54  6A 00                  LDI  UL,0               ; U = RX
56  B5 01          RBYTE:  LDI  A,1                ; sentinel: leaves into C after 8 bits
58  FD 5B 80       RBIT:   ORI  #(Y),&80           ; SCL = 1
5B  FD 4D 04               BII  #(X),BM            ; read SDA
5E  8B 01                  BZS+ R0
60  FB                     SEC                     ; bit 1 (C = 0 in the loop, so bit 0 needs no REC)
61  DB             R0:     ROL                     ; A = A*2 + bit
62  FD 59 7F               ANI  #(Y),&7F           ; SCL = 0
65  91 0F                  BCR- RBIT               ; C = 1: the sentinel left, byte complete
67  61                     SIN  U                  ; store, U++
68  6E 00          RCMP:   CPI  UL,0               ; UL - R (R written in RD): C = 1 for the last one
6A  83 01                  BCS+ R9                 ; last one: NACK (SDA = 1)
6C  E3                     RPU                     ; ACK: SDA = 0
6D  FD 5B 80       R9:     ORI  #(Y),&80           ; 9th SCL pulse (ACK or NACK)
70  FD 59 7F               ANI  #(Y),&7F           ; (ORI/ANI do not change C)
73  83 03                  BCS+ OK
75  E1                     SPU                     ; release SDA; C = 0
76  9E 22                  BCH- RBYTE
78  B5 00          OK:     LDI  A,0
7A  8E 06                  BCH+ STOP
7C  B5 01          NAKA:   LDI  A,1
7E  8E 02                  BCH+ STOP
80  B5 02          NAKD:   LDI  A,2
82  BE 4C 95       STOP:   SJP  SDA0               ; SDA = 0 while SCL = 0
85  FD 5B 80               ORI  #(Y),&80           ; SCL = 1
88  E1                     SPU                     ; SDA 0 -> 1 while SCL = 1: STOP
89  AE 4C FF       EXIT:   STA  (IP,&FF)           ; IS = result
8C  0A                     STA  XL
8D  48 00                  LDI  XH,0               ; X = result ...
8F  FB                     SEC                     ; ... C=1: BASIC copies X into E of XCALL IC,E
90  9A                     RTN
                      ;
                      ; START: SDA 1 -> 0 while SCL = 1, then SCL = 0 (A and C unchanged).
                      ; SDA0 (entry from STOP while SCL = 0): SDA = 0, and the second SCL = 0 changes nothing.
91  E1             START:  SPU                     ; SDA = 1
92  FD 5B 80               ORI  #(Y),&80           ; SCL = 1
95  E3             SDA0:   RPU                     ; SDA 1 -> 0 (START)
96  FD 59 7F               ANI  #(Y),&7F           ; SCL = 0
99  9A                     RTN
                      ;
                      ; ADDR: START (or repeated START), then the byte D*2+C and further bytes from TX.
                      ; After START SDA = 0, so sending starts in state L.
9A  BE 4C 91       ADDR:   SJP  START
9D  A5 4C FC               LDA  (IP,&FC)           ; D
A0  DB                     ROL                     ; D*2 + C (0 write, 1 read)
A1  FB                     SEC
A2  DB                     ROL                     ; C = bit 7, sentinel 1 -> bit 0
A3  8E 08                  BCH+ LDEC
                      ;
                      ; SEND: sends the byte in A, then further bytes from TX (LIN U), until UL = W.
                      ; Result: C = 1 everything acknowledged, C = 0 no ACK (UL tells after which).
                      ; Two states: H (SDA = 1) and L (SDA = 0); only a bit that differs from the
                      ; previous one changes SDA. The end of a byte (sentinel: A = 0, Z flag after
                      ; SHL/ROL) only counts after a 1 bit - after a 0 bit (C = 0) it cannot be the sentinel.
A5  E3             H0:     RPU                     ; H, bit 0: SDA = 0 -> state L
A6  FD 5B 80       LC:     ORI  #(Y),&80           ; SCL pulse
A9  FD 59 7F               ANI  #(Y),&7F
AC  D9                     SHL                     ; C = next bit
AD  91 09          LDEC:   BCR- LC                 ; L, bit 0: SDA unchanged
AF  8B 0E                  BZS+ SACKL              ; C = 1 and Z = 1: sentinel, end of the byte
B1  E1                     SPU                     ; L, bit 1: SDA = 1 -> state H
B2  FD 5B 80       HC:     ORI  #(Y),&80           ; SCL pulse
B5  FD 59 7F               ANI  #(Y),&7F
B8  D9                     SHL
B9  91 16          HDEC:   BCR- H0                 ; H, bit 0
BB  99 0B                  BZR- HC                 ; H, bit 1: SDA unchanged
BD  8E 01                  BCH+ SACKH              ; sentinel in state H: SDA already released
BF  E1             SACKL:  SPU                     ; release SDA: the device sends the ACK
C0  FD 5B 80       SACKH:  ORI  #(Y),&80           ; 9th SCL pulse
C3  FD 4D 04               BII  #(X),BM            ; ACK = 0
C6  89 0C                  BZR+ SNAK
C8  FD 59 7F               ANI  #(Y),&7F           ; SCL = 0
CB  6E 00          WCMP:   CPI  UL,0               ; W bytes sent? (W written in FREE; equal: C = 1)
CD  8B 09                  BZS+ SDONE
CF  65                     LIN  U                  ; A = byte, U++
D0  FB                     SEC
D1  DB                     ROL                     ; C = bit 7, sentinel 1 -> bit 0
D2  9E 1B                  BCH- HDEC               ; after the ACK SDA is released: state H
D4  FD 59 7F       SNAK:   ANI  #(Y),&7F           ; SCL = 0
D7  F9                     REC                     ; C = 0: no ACK
D8  9A             SDONE:  RTN
