                  ; =====================================================================
                  ; I2C master Z80 for the PC-1600, speed lab, V1: no NOPs, shorter receive loop
                  ; Generated by tools/make_lab.py from asm/i2c_z80_v1.0.asm (main code) with fixed entry points.
                  ; Principle, pins and rules: see i2c_z80_v1.0.asm (SDA = page of the code + I register, A8 = pin 31).
                  ; Entry points: WH &C100  RH &C120  STH &C1F5 | STT &C200  WL &C210  SL &C220  STL &C2F5
                  ; =====================================================================
                  
                  HV      EQU 0C1h        ; I for the pages with A8 = 1 (SDA released)
                  LV      EQU 0C2h        ; I for the pages with A8 = 0 (SDA low)
                  OPC     EQU 18h         ; port: bit 7 -> SDO (pin 29, SCL), bit 6 -> buzzer (keep 0)
                  DDB     EQU 1Dh         ; port B direction (bit 2 = PB2 must be an input)
                  PBP     EQU 1Fh         ; port B data (bit 2 = SDA read back)
                  
                  S_H1    EQU 81h         ; SCL = 1, A register bit 0 = 1 (A8 = 1)
                  S_L1    EQU 01h         ; SCL = 0, A8 = 1
                  S_H0    EQU 80h         ; SCL = 1, A8 = 0
                  S_L0    EQU 00h         ; SCL = 0, A8 = 0
                  
                  RX      EQU 0C600h
                  TX      EQU 0C700h
                  CNT     EQU 0C5FBh
                  IA      EQU 0C5FCh
                  IW      EQU 0C5FDh
                  IR      EQU 0C5FEh
                  IS      EQU 0C5FFh
                  
                          ORG 0C100h
C100  3E 81        WH:     LD A,S_H1
C102  D3 18                OUT (OPC),A
C104  DB 1F                IN A,(PBP)
C106  57                   LD D,A
C107  3E 01                LD A,S_L1
C109  D3 18                OUT (OPC),A
C10B  C9                   RET
                          ORG 0C120h
C120  3E 81        RH:     LD A,S_H1
C122  D3 18                OUT (OPC),A
C124  DB 1F                IN A,(PBP)
C126  1F                   RRA             ; bit 2 -> carry
C127  1F                   RRA
C128  1F                   RRA
C129  3E 01                LD A,S_L1       ; LD and OUT do not change the carry
C12B  D3 18                OUT (OPC),A
C12D  CB 13                RL E
C12F  10 EF                DJNZ RH
C131  C9                   RET
                          ORG 0C140h
C140  CB 01        SH:     RLC C
C142  D2 52 C1             JP NC,SH_L
C145  3E 81        SH_CLK: LD A,S_H1
C147  D3 18                OUT (OPC),A
C149  3E 01                LD A,S_L1
C14B  D3 18                OUT (OPC),A
C14D  10 F1                DJNZ SH
C14F  C3 00 C1             JP WH
C152  3E C2        SH_L:   LD A,LV
C154  ED 47                LD I,A
C156  C3 25 C2             JP SL_CLK
                          ORG 0C1F5h
C1F5  3E 81        STH:    LD A,S_H1
C1F7  D3 18                OUT (OPC),A
C1F9  00                   NOP
C1FA  00                   NOP
C1FB  00                   NOP
C1FC  3E C2                LD A,LV
C1FE  ED 47                LD I,A
                          ORG 0C200h
C200  00           STT:    NOP
C201  00                   NOP
C202  3E 00                LD A,S_L0
C204  D3 18                OUT (OPC),A
C206  C9                   RET
                          ORG 0C210h
C210  3E 80        WL:     LD A,S_H0
C212  D3 18                OUT (OPC),A
C214  3E 00                LD A,S_L0
C216  D3 18                OUT (OPC),A
C218  C9                   RET
                          ORG 0C220h
C220  CB 01        SL:     RLC C
C222  DA 36 C2             JP C,SL_H
C225  3E 80        SL_CLK: LD A,S_H0
C227  D3 18                OUT (OPC),A
C229  3E 00                LD A,S_L0
C22B  D3 18                OUT (OPC),A
C22D  10 F1                DJNZ SL
C22F  3E C1                LD A,HV
C231  ED 47                LD I,A
C233  C3 00 C1             JP WH
C236  3E C1        SL_H:   LD A,HV
C238  ED 47                LD I,A
C23A  C3 45 C1             JP SH_CLK
                          ORG 0C2F5h
C2F5  3E 80        STL:    LD A,S_H0
C2F7  D3 18                OUT (OPC),A
C2F9  00                   NOP
C2FA  00                   NOP
C2FB  00                   NOP
C2FC  3E C1                LD A,HV
C2FE  ED 47                LD I,A
                          ORG 0C300h
C300  00           STP2:   NOP
C301  00                   NOP
C302  00                   NOP
C303  3E 01                LD A,S_L1
C305  D3 18                OUT (OPC),A
C307  C9                   RET
                  
                          ORG 0C400h
C400  3E 01        IC:     LD A,S_L1
C402  D3 18                OUT (OPC),A             ; SCL low at once: from here on A8 may chop
C404  ED 57                LD A,I
C406  F5                   PUSH AF                 ; I and IFF2 (P/V flag)
C407  F3                   DI
C408  DB 1D                IN A,(DDB)
C40A  E6 FB                AND 0FBh
C40C  D3 1D                OUT (DDB),A             ; PB2 = input
C40E  AF                   XOR A
C40F  32 FF C5             LD (IS),A
C412  CD B8 C4             CALL BUSCHK
C415  DA B1 C4             JP C,E3
C418  3A FD C5             LD A,(IW)
C41B  B7                   OR A
C41C  20 06                JR NZ,DOWR
C41E  3A FE C5             LD A,(IR)
C421  B7                   OR A
C422  20 35                JR NZ,DORD              ; W = 0, R > 0: read at once
C424  CD CB C4     DOWR:   CALL START
C427  3A FC C5             LD A,(IA)
C42A  87                   ADD A,A
C42B  4F                   LD C,A                  ; address, write bit = 0
C42C  CD D9 C4             CALL SENDB
C42F  CB 52                BIT 2,D
C431  C2 A3 C4             JP NZ,E1                ; no ACK
C434  3A FD C5             LD A,(IW)
C437  B7                   OR A
C438  28 19                JR Z,AFTW
C43A  32 FB C5             LD (CNT),A
C43D  21 00 C7             LD HL,TX
C440  4E           WLP:    LD C,(HL)
C441  23                   INC HL
C442  CD D9 C4             CALL SENDB
C445  CB 52                BIT 2,D
C447  C2 A7 C4             JP NZ,E2
C44A  3A FB C5             LD A,(CNT)
C44D  3D                   DEC A
C44E  32 FB C5             LD (CNT),A
C451  20 ED                JR NZ,WLP
C453  3A FE C5     AFTW:   LD A,(IR)
C456  B7                   OR A
C457  28 38                JR Z,DOSTOP
C459  CD CB C4     DORD:   CALL START              ; (repeated) START
C45C  3A FC C5             LD A,(IA)
C45F  87                   ADD A,A
C460  3C                   INC A
C461  4F                   LD C,A                  ; address, read bit = 1
C462  CD D9 C4             CALL SENDB
C465  CB 52                BIT 2,D
C467  C2 A3 C4             JP NZ,E1
C46A  3A FE C5             LD A,(IR)
C46D  32 FB C5             LD (CNT),A
C470  21 00 C6             LD HL,RX
C473  CD E2 C4     RLP:    CALL RECVB
C476  73                   LD (HL),E
C477  23                   INC HL
C478  3A FB C5             LD A,(CNT)
C47B  3D                   DEC A
C47C  32 FB C5             LD (CNT),A
C47F  28 09                JR Z,RLAST
C481  3E C2                LD A,LV
C483  ED 47                LD I,A
C485  CD 10 C2             CALL WL                 ; ACK
C488  18 E9                JR RLP
C48A  3E C1        RLAST:  LD A,HV
C48C  ED 47                LD I,A
C48E  CD 00 C1             CALL WH                 ; NACK after the last byte
C491  CD D2 C4     DOSTOP: CALL STOP
C494  F1           EXIT:   POP AF
C495  ED 47                LD I,A                  ; I restored (flags are not changed)
C497  E2 9B C4             JP PO,EX2               ; P/V = IFF2: interrupts were off
C49A  FB                   EI
C49B  3A FF C5     EX2:    LD A,(IS)
C49E  5F                   LD E,A
C49F  16 00                LD D,0
C4A1  37                   SCF                     ; CALL IC,E returns the result in E
C4A2  C9                   RET
C4A3  3E 01        E1:     LD A,1
C4A5  18 02                JR ERR
C4A7  3E 02        E2:     LD A,2
C4A9  32 FF C5     ERR:    LD (IS),A
C4AC  CD D2 C4             CALL STOP
C4AF  18 E3                JR EXIT
C4B1  3E 03        E3:     LD A,3
C4B3  32 FF C5             LD (IS),A
C4B6  18 DC                JR EXIT
                  
C4B8  3E C1        BUSCHK: LD A,HV                 ; up to 10 clocks until SDA is high
C4BA  ED 47                LD I,A
C4BC  06 0A                LD B,10
C4BE  CD 00 C1     BC1:    CALL WH
C4C1  CB 52                BIT 2,D
C4C3  20 04                JR NZ,BCOK
C4C5  10 F7                DJNZ BC1
C4C7  37                   SCF                     ; SDA stuck low
C4C8  C9                   RET
C4C9  B7           BCOK:   OR A
C4CA  C9                   RET
                  
C4CB  3E C1        START:  LD A,HV
C4CD  ED 47                LD I,A
C4CF  C3 F5 C1             JP STH
C4D2  3E C2        STOP:   LD A,LV
C4D4  ED 47                LD I,A
C4D6  C3 F5 C2             JP STL
C4D9  3E C2        SENDB:  LD A,LV                 ; send the byte in C, then read the ACK bit into D
C4DB  ED 47                LD I,A
C4DD  06 08                LD B,8
C4DF  C3 20 C2             JP SL
C4E2  3E C1        RECVB:  LD A,HV                 ; read a byte into E
C4E4  ED 47                LD I,A
C4E6  06 08                LD B,8
C4E8  C3 20 C1             JP RH
                  
                  ; ---------------------------------------------------------------------
                  ; port benchmark: 2560 port accesses per call (BASIC times the calls with TIME)
                  ; ---------------------------------------------------------------------
                          ORG 0C500h
C500  F3           BO:     DI                      ; (the first byte, 243, marks the lab version)
C501  3E 01                LD A,S_L1
C503  06 00                LD B,0
                  BO1:
C505  D3 18                OUT (OPC),A
C507  D3 18                OUT (OPC),A
C509  D3 18                OUT (OPC),A
C50B  D3 18                OUT (OPC),A
C50D  D3 18                OUT (OPC),A
C50F  D3 18                OUT (OPC),A
C511  D3 18                OUT (OPC),A
C513  D3 18                OUT (OPC),A
C515  D3 18                OUT (OPC),A
C517  D3 18                OUT (OPC),A
C519  10 EA                DJNZ BO1
C51B  FB                   EI
C51C  C9                   RET
                          ORG 0C520h
C520  F3           BI:     DI
C521  06 00                LD B,0
                  BI1:
C523  DB 1F                IN A,(PBP)
C525  DB 1F                IN A,(PBP)
C527  DB 1F                IN A,(PBP)
C529  DB 1F                IN A,(PBP)
C52B  DB 1F                IN A,(PBP)
C52D  DB 1F                IN A,(PBP)
C52F  DB 1F                IN A,(PBP)
C531  DB 1F                IN A,(PBP)
C533  DB 1F                IN A,(PBP)
C535  DB 1F                IN A,(PBP)
C537  10 EA                DJNZ BI1
C539  FB                   EI
C53A  C9                   RET
                          ORG 0C540h
C540  F3           BN:     DI
C541  06 00                LD B,0
                  BN1:
C543  00                   NOP
C544  00                   NOP
C545  00                   NOP
C546  00                   NOP
C547  00                   NOP
C548  00                   NOP
C549  00                   NOP
C54A  00                   NOP
C54B  00                   NOP
C54C  00                   NOP
C54D  10 F4                DJNZ BN1
C54F  FB                   EI
C550  C9                   RET
                          ORG 0C560h
C560  C9           BR:     RET                     ; empty routine: measures the time of the BASIC CALL itself
