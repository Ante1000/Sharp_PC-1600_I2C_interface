                  ; =====================================================================
                  ; I2C master Z80 for the PC-1600, speed lab, V2: V1 with the send loop unrolled
                  ; Generated by tools/make_lab.py from asm/i2c_z80_v1.0.asm (main code) with fixed entry points.
                  ; Principle, pins and rules: see i2c_z80_v1.0.asm (SDA = page of the code + I register, A8 = pin 31).
                  ; Entry points: WH &C100  RH &C120  STH &C1F5 | STT &C200  WL &C210  SL &C220  STL &C2F5
                  ; =====================================================================
                  
                  HV      EQU 0C1h        ; I for the pages with A8 = 1 (SDA released)
                  LV      EQU 0C2h        ; I for the pages with A8 = 0 (SDA low)
                  OPC     EQU 18h         ; port: bit 7 -> SDO (pin 29, SCL), bit 6 -> buzzer (keep 0)
                  DDB     EQU 1Dh         ; port B direction (bit 2 = PB2 must be an input)
                  PBP     EQU 1Fh         ; port B data (bit 2 = SDA read back)
                  
                  S_H1    EQU 81h         ; SCL = 1, A register bit 0 = 1 (A8 = 1)
                  S_L1    EQU 01h         ; SCL = 0, A8 = 1
                  S_H0    EQU 80h         ; SCL = 1, A8 = 0
                  S_L0    EQU 00h         ; SCL = 0, A8 = 0
                  
                  RX      EQU 0C600h
                  TX      EQU 0C700h
                  CNT     EQU 0C5FBh
                  IA      EQU 0C5FCh
                  IW      EQU 0C5FDh
                  IR      EQU 0C5FEh
                  IS      EQU 0C5FFh
                  
                          ORG 0C100h
