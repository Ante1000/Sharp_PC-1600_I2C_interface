C407  F3                   DI
C408  DB 1D                IN A,(DDB)
C40A  E6 FB                AND 0FBh
C40C  D3 1D                OUT (DDB),A             ; PB2 = input
C40E  AF                   XOR A
C40F  32 FF C5             LD (IS),A
