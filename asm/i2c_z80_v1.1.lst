C2A1  78                   LD A,B
C2A2  ED 47                LD I,A
C2A4  C3 84 C1             JP SH0C
                  ACKL:
C2A7  ED 51                OUT (C),D
C2A9  ED 41                OUT (C),B
C2AB  04                   INC B
C2AC  78                   LD A,B
C2AD  ED 47                LD I,A
C2AF  C3 10 C3             JP RDB1
                          ORG 0C2F5h
C2F5  3E 80        STL:    LD A,S_H0
C2F7  D3 18                OUT (OPC),A
C2F9  00                   NOP
C2FA  00                   NOP
C2FB  00                   NOP
C2FC  3E 01                LD A,HV
C2FE  ED 47                LD I,A
                          ORG 0C300h
C300  00           STP2:   NOP
C301  00                   NOP
C302  00                   NOP
C303  3E 01                LD A,S_L1
C305  D3 18                OUT (OPC),A
C307  C9                   RET
                          ORG 0C310h
                  RH2:
                  RDB1:
