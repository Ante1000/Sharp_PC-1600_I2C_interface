C258  C2 99 C2             JP NZ,TH1
                  SL1C:
C25B  ED 51                OUT (C),D
C25D  ED 41                OUT (C),B
C25F  CB 43                BIT 0,E
C261  C2 A0 C2             JP NZ,TH0
                  SL0C:
C264  ED 51                OUT (C),D
C266  ED 41                OUT (C),B
C268  04                   INC B
C269  78                   LD A,B
C26A  ED 47                LD I,A
C26C  C3 85 C3             JP ACKB
C26F  04           TH7:    INC B
C270  78                   LD A,B
C271  ED 47                LD I,A
C273  C3 45 C1             JP SH7C
C276  04           TH6:    INC B
C277  78                   LD A,B
C278  ED 47                LD I,A
C27A  C3 4E C1             JP SH6C
C27D  04           TH5:    INC B
C27E  78                   LD A,B
C27F  ED 47                LD I,A
C281  C3 57 C1             JP SH5C
