                  ; =====================================================================
                  ; I2C master Z80 for the PC-1600, version 1.1 (speed lab version V10)
                  ; Same interface as v1.0:  POKE &C5FC,D,W,R : CALL &C400,E  (see i2c_z80_v1.0.asm)
                  ; SDA = page of the code + I register (A8 = pin 31), SCL = OPC bit 7 (pin 29), SDA read = PB2 (pin 27).
                  ; Generated by tools/make_lab.py from the lab sources. 56 kHz in the ideal simulator; on the real
                  ; PC-1600 about 43 kHz read / 54 kHz write: there every opcode fetch has one wait state and every
                  ; I/O cycle one more (simulator option --real), so a prefixed instruction (ED, CB) costs 2 T more.
                  ; Registers in the bit loops: B = SDA state (0/1, also the high address byte of OUT (C),r), C = 18h (OPC),
                  ; D = 80h (SCL high), E = data byte, HL = buffer pointer; I = B.
                  ; =====================================================================
                  
                  HV      EQU 01h        ; I for the pages with A8 = 1 (SDA released)
                  LV      EQU 00h        ; I for the pages with A8 = 0 (SDA low)
                  OPC     EQU 18h         ; port: bit 7 -> SDO (pin 29, SCL), bit 6 -> buzzer (keep 0)
                  DDB     EQU 1Dh         ; port B direction (bit 2 = PB2 must be an input)
                  PBP     EQU 1Fh         ; port B data (bit 2 = SDA read back)
                  
                  S_H1    EQU 81h         ; SCL = 1, A register bit 0 = 1 (A8 = 1)
                  S_L1    EQU 01h         ; SCL = 0, A8 = 1
                  S_H0    EQU 80h         ; SCL = 1, A8 = 0
                  S_L0    EQU 00h         ; SCL = 0, A8 = 0
                  
                  RX      EQU 0C600h
                  TX      EQU 0C700h
                  CNT     EQU 0C5FBh
                  IA      EQU 0C5FCh
                  IW      EQU 0C5FDh
                  IR      EQU 0C5FEh
                  IS      EQU 0C5FFh
                  
                  TXH     EQU 0C7h
                  RPT     EQU 0C5FAh
                  RCT     EQU 0C5F9h
                          ORG 0C100h
C100  3E 81        WH:     LD A,S_H1
C102  D3 18                OUT (OPC),A
C104  DB 1F                IN A,(PBP)
C106  57                   LD D,A
C107  3E 01                LD A,S_L1
C109  D3 18                OUT (OPC),A
C10B  C9                   RET
                          ORG 0C120h
C120  C3 10 C3     RH:     JP RH2
                          ORG 0C140h
C140  CB 7B        SH7:    BIT 7,E
C142  CA 8B C1             JP Z,TL7
                  SH7C:
